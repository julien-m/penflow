{
  "version": "2.11",
  "children": [
    {
      "id": "checkoutScreen",
      "type": "frame",
      "name": "checkout",
      "x": 0,
      "y": 0,
      "width": 390,
      "height": 844,
      "layout": "vertical",
      "gap": 16,
      "padding": 24,
      "alignItems": "center",
      "fill": "#FFFFFF",
      "context": "role=screen; semantic_id=checkout",
      "children": [
        {
          "id": "checkoutTitle0",
          "name": "checkout.title",
          "context": "role=text; semantic_id=checkout.title",
          "type": "text",
          "content": "Checkout",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "fontSize": 24,
          "fontWeight": "600",
          "fill": "#111827"
        },
        {
          "id": "checkoutPay1",
          "name": "checkout.pay",
          "context": "intent=submit_payment; role=button; semantic_id=checkout.pay",
          "type": "frame",
          "layout": "horizontal",
          "width": "fill_container",
          "height": "fit_content(44)",
          "padding": [
            12,
            16
          ],
          "gap": 8,
          "alignItems": "center",
          "justifyContent": "center",
          "cornerRadius": 8,
          "fill": "#0057FF",
          "children": [
            {
              "id": "checkoutPayLabel",
              "type": "text",
              "content": "Pay",
              "fontSize": 16,
              "fontWeight": "600",
              "fill": "#FFFFFF",
              "context": "role=text; semantic_id=checkout.pay.label"
            }
          ]
        }
      ]
    }
  ]
}
