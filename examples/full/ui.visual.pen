{
  "children": [
    {
      "alignItems": "stretch",
      "children": [
        {
          "content": "Order summary",
          "context": "variant=heading",
          "fill": "#111827",
          "fontSize": 24,
          "fontWeight": "600",
          "id": "orderSummary",
          "name": "Order summary",
          "textGrowth": "fixed-width",
          "type": "text",
          "width": "fill_container"
        },
        {
          "content": "Selected payment method",
          "context": "variant=body",
          "fill": "#374151",
          "fontSize": 16,
          "fontWeight": "400",
          "id": "selectedPaymentMethod",
          "name": "Selected payment method",
          "textGrowth": "fixed-width",
          "type": "text",
          "width": "fill_container"
        },
        {
          "alignItems": "center",
          "children": [
            {
              "content": "Pay now",
              "context": "variant=label",
              "fill": "#FFFFFF",
              "fontSize": 16,
              "fontWeight": "600",
              "id": "payNowLabel",
              "type": "text"
            }
          ],
          "cornerRadius": 8,
          "fill": "#0057FF",
          "gap": 8,
          "height": "fit_content(44)",
          "id": "payNowButton",
          "justifyContent": "center",
          "layout": "horizontal",
          "name": "Pay now",
          "padding": [
            12,
            16
          ],
          "type": "frame",
          "width": "fill_container"
        }
      ],
      "context": "role=screen; semantic_id=checkout",
      "fill": "#FFFFFF",
      "gap": 16,
      "height": 844,
      "id": "checkoutScreen",
      "layout": "vertical",
      "name": "checkout",
      "padding": 24,
      "type": "frame",
      "width": 390,
      "x": 0,
      "y": 0
    }
  ],
  "version": "2.11"
}
