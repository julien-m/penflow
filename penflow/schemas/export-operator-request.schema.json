{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penflow.local/schemas/export-operator-request.schema.json",
  "title": "Penflow Export Operator Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "run_id",
    "operation",
    "source",
    "document",
    "persistence_receipt",
    "contract",
    "coverage"
  ],
  "properties": {
    "kind": {"const": "penflow-export-operator-request"},
    "version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "persistence_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}}
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "screen", "state", "node_id", "export", "references"],
        "properties": {
          "surface": {"type": "string", "minLength": 1},
          "screen": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "node_id": {"type": "string", "minLength": 1},
          "export": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "width", "height", "scale", "format"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "scale": {"type": "number", "exclusiveMinimum": 0},
              "format": {"type": "string", "minLength": 1}
            }
          },
          "references": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "surface", "role", "state", "region", "design_intent"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "surface": {"type": "string", "minLength": 1},
                "role": {"type": "string", "minLength": 1},
                "state": {"type": "string", "minLength": 1},
                "region": {"type": "string", "minLength": 1},
                "design_intent": {"type": "string", "minLength": 1},
                "crop": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["width", "height"],
                  "properties": {
                    "width": {"type": "number", "exclusiveMinimum": 0},
                    "height": {"type": "number", "exclusiveMinimum": 0}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
