{
  "$comment": "Feature 069 / C44: adapter-produced causal transition observations.",
  "$id": "https://penflow.dev/schemas/causal-transition-evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Penflow Causal Transition Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "contract", "runs", "observations"],
  "properties": {
    "kind": {"const": "penflow-causal-transition-evidence"},
    "version": {"const": 1},
    "contract": {"$ref": "#/$defs/contractBinding"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/run"}
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "contractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "surface"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "adapter": {"$ref": "#/$defs/adapter"},
        "surface": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "stateObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen", "state", "value"],
      "properties": {
        "screen": {"$ref": "#/$defs/nonEmptyString"},
        "state": {"$ref": "#/$defs/nonEmptyString"},
        "value": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen", "state"],
      "properties": {
        "screen": {"$ref": "#/$defs/nonEmptyString"},
        "state": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "actionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "test_id", "visible", "event"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "test_id": {"$ref": "#/$defs/nonEmptyString"},
        "visible": {"const": true},
        "event": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run_id", "kind", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": ["runtime-event", "runtime-state", "runtime-screenshot"]
        },
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "transition_id",
        "run_id",
        "outcome",
        "action",
        "pre_state",
        "post_state",
        "destination",
        "evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "transition_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "outcome": {"$ref": "#/$defs/identifier"},
        "action": {"$ref": "#/$defs/actionObservation"},
        "pre_state": {"$ref": "#/$defs/stateObservation"},
        "post_state": {"$ref": "#/$defs/stateObservation"},
        "destination": {"$ref": "#/$defs/destination"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/receipt"}
        }
      }
    }
  }
}
