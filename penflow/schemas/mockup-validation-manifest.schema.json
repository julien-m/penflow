{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "LiveSpec traceability anchors: @spec(FR-001) — .specs/features/056-evidence-run-identity-theme-fingerprint/spec.md#fr-001",
  "$id": "https://penflow.dev/schemas/mockup-validation-manifest.schema.json",
  "title": "Penflow Mockup Validation Manifest",
  "type": "object",
  "required": ["renderer", "sourceFile", "status", "validatedAt", "screens"],
  "additionalProperties": false,
  "properties": {
    "renderer": {"type": "string"},
    "sourceFile": {"type": "string"},
    "status": {"type": "string"},
    "validatedAt": {"type": "string"},
    "runId": {"type": "string", "minLength": 1},
    "references_manifest": {"type": "string", "minLength": 1},
    "theme": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["screen_id", "semantic_id", "pencil_node_id", "png", "sha256", "layout_checked", "screenshot_checked"],
        "additionalProperties": false,
        "properties": {
          "screen_id": {"type": "string"},
          "semantic_id": {"type": "string"},
          "pencil_node_id": {"type": "string"},
          "png": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "layout_checked": {"type": "boolean"},
          "screenshot_checked": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
