{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penflow.dev/schemas/actual-ui-tree.schema.json",
  "title": "Penflow Actual UI Tree",
  "description": "After-code runtime UI tree (contract C12) emitted by external runtimes (SwiftUI, React, Rust/Dioxus, etc.) and validated by `penflow validate-actual`.",
  "type": "object",
  "required": [
    "version",
    "screens"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "const": 1
    },
    "screens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screen"
      },
      "minItems": 1
    },
    "observed_states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "screen_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "facts": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "description": "Observed data facts of this capture (record status, mode), bound to its observed_states witness."
          }
        },
        "required": [
          "screen_id",
          "state",
          "scenario_id",
          "session_id",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "screen": {
      "type": "object",
      "required": [
        "screen_id",
        "root"
      ],
      "additionalProperties": true,
      "properties": {
        "screen_id": {
          "type": "string",
          "minLength": 1
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "root": {
          "$ref": "#/$defs/node"
        },
        "state": {
          "description": "Contract state this capture witnesses (state-scoped comparison); one capture per (screen_id, state).",
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "description": "Scenario of the observed_states witness of this state capture.",
          "type": "string",
          "minLength": 1
        },
        "states": {
          "description": "Expected trees only: every state the contract declares for the screen.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "description": "Observed data facts of this capture (record status, mode), bound to its observed_states witness."
        }
      },
      "dependentRequired": {
        "state": [
          "scenario_id"
        ],
        "scenario_id": [
          "state"
        ]
      }
    },
    "viewport": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": true,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "role",
        "bbox"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "pencil_id": {
          "type": "string"
        },
        "semantic_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "visual": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "fill": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "$ref": "#/$defs/imagePaint"
                }
              ]
            },
            "stroke": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": [
                    "fill",
                    "thickness"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "fill": {
                      "type": "string",
                      "minLength": 1
                    },
                    "thickness": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "fontFamily": {
              "type": "string",
              "minLength": 1
            },
            "layout": {
              "type": "string",
              "minLength": 1
            },
            "alignItems": {
              "type": "string",
              "minLength": 1
            },
            "cornerRadius": {
              "type": "number"
            },
            "fontSize": {
              "type": "number"
            },
            "gap": {
              "type": "number"
            },
            "fontWeight": {
              "type": [
                "string",
                "number"
              ]
            },
            "padding": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  }
                }
              ]
            },
            "textAlign": {
              "type": "string",
              "minLength": 1
            },
            "strokeThickness": {
              "type": "number",
              "minimum": 0
            },
            "strokeWidth": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "top": {
                      "type": "number",
                      "minimum": 0
                    },
                    "right": {
                      "type": "number",
                      "minimum": 0
                    },
                    "bottom": {
                      "type": "number",
                      "minimum": 0
                    },
                    "left": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "strokeAlignment": {
              "enum": [
                "inner",
                "center",
                "outer"
              ]
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "instance_id": {
          "description": "Runtime instance of a repeated node; the comparison key is semantic_id::instance_id.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*::)\\S+$"
        },
        "states": {
          "description": "Expected trees only: the contract states in which this node exists; absent means every state.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "repeat_model": {
          "description": "Expected trees only: the contract repeat model of a collection template node.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collection",
            "item_model",
            "item_key",
            "instance_id_template"
          ],
          "properties": {
            "collection": {
              "type": "string",
              "minLength": 1
            },
            "item_model": {
              "type": "string",
              "minLength": 1
            },
            "item_key": {
              "type": "string",
              "minLength": 1
            },
            "instance_id_template": {
              "type": "string",
              "pattern": "^(?!.*::)[^{}\\s]*(?:\\{[^{}\\s]+\\}[^{}\\s]*)+$"
            }
          }
        },
        "sizing": {
          "description": "Expected trees only: the design source sizing of each dimension (fixed number, fill_container, fit_content, or no value).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "enum": [
                "fixed",
                "fill",
                "hug",
                "unspecified"
              ]
            },
            "height": {
              "enum": [
                "fixed",
                "fill",
                "hug",
                "unspecified"
              ]
            }
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Text of the label associated with a form control (HTML <label for> or aria-labelledby); expected from a sibling label-for node."
        },
        "visible_when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact",
            "in"
          ],
          "description": "Data condition under which the node exists within its states (for example the controls a record status offers). Proved by the facts each capture records with its witness.",
          "properties": {
            "fact": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:[._-][a-z0-9_]+)*$"
            },
            "in": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "bbox": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": true,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "imagePaint": {
      "$comment": "Native Pencil image paint, exported unchanged (a bitmap reference, not a color).",
      "type": "object",
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "image"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
