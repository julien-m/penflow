{
  "$comment": "@spec FR-009: Strict lifecycle report envelope — .specs/features/074-penflow-doctor-consumer-project-hygiene/spec.md#fr-009",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penflow.local/schemas/lifecycle-report.schema.json",
  "title": "Penflow Lifecycle Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stable_result", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "stable_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "project_root",
        "canonical_pen",
        "findings",
        "actions",
        "git",
        "runs",
        "cleanup",
        "summary"
      ],
      "properties": {
        "status": {"enum": ["PASS", "BLOCKED", "ERROR"]},
        "project_root": {"type": ["string", "null"], "minLength": 1},
        "canonical_pen": {"type": ["string", "null"], "minLength": 1},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "git": {"$ref": "#/$defs/git"},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/manifest"}},
        "cleanup": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "schema_version",
            "run_id",
            "phase",
            "cleanup_state",
            "deleted",
            "preserved",
            "blocked",
            "errors",
            "reclaimed_bytes",
            "preserved_bytes",
            "blocked_bytes"
          ],
          "properties": {
            "schema_version": {"const": 1},
            "run_id": {"type": "string", "minLength": 1},
            "phase": {"enum": ["preflight", "postflight"]},
            "cleanup_state": {
              "enum": ["not_eligible", "eligible", "in_progress", "completed", "cleanup_failed"]
            },
            "deleted": {"type": "array", "items": {"$ref": "#/$defs/cleanup_item"}},
            "preserved": {"type": "array", "items": {"$ref": "#/$defs/cleanup_item"}},
            "blocked": {"type": "array", "items": {"$ref": "#/$defs/cleanup_item"}},
            "errors": {"type": "array", "items": {"$ref": "#/$defs/cleanup_error"}},
            "reclaimed_bytes": {"type": "integer", "minimum": 0},
            "preserved_bytes": {"type": "integer", "minimum": 0},
            "blocked_bytes": {"type": "integer", "minimum": 0}
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finding_count",
            "blocking_count",
            "action_count",
            "run_count",
            "reclaimed_bytes",
            "preserved_bytes",
            "blocked_bytes"
          ],
          "properties": {
            "finding_count": {"type": "integer", "minimum": 0},
            "blocking_count": {"type": "integer", "minimum": 0},
            "action_count": {"type": "integer", "minimum": 0},
            "run_count": {"type": "integer", "minimum": 0},
            "reclaimed_bytes": {"type": "integer", "minimum": 0},
            "preserved_bytes": {"type": "integer", "minimum": 0},
            "blocked_bytes": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "pid", "host", "errors"],
      "properties": {
        "observed_at": {"type": "string", "minLength": 1},
        "pid": {"type": ["integer", "null"], "minimum": 1},
        "host": {"type": ["string", "null"], "minLength": 1},
        "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "path", "git_state", "details", "repair_action"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning"]},
        "path": {"type": ["string", "null"], "minLength": 1},
        "git_state": {"type": ["string", "null"], "minLength": 1},
        "details": {"type": "string", "minLength": 1},
        "repair_action": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "status"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"], "minLength": 1},
        "status": {"enum": ["planned", "applied"]}
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_sha256_before",
        "index_sha256_after",
        "index_unchanged",
        "porcelain_sha256_before",
        "porcelain_sha256_after",
        "porcelain_unchanged",
        "paths"
      ],
      "properties": {
        "index_sha256_before": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "index_sha256_after": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "index_unchanged": {"type": "boolean"},
        "porcelain_sha256_before": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "porcelain_sha256_after": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "porcelain_unchanged": {"type": "boolean"},
        "paths": {"type": "array", "items": {"$ref": "#/$defs/git_path"}}
      }
    },
    "git_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "index_state", "worktree_state", "flags", "blocking"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "index_state": {"type": "string", "minLength": 1},
        "worktree_state": {"type": "string", "minLength": 1},
        "flags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "blocking": {"type": "boolean"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "run_id",
        "command",
        "producer_state",
        "cleanup_state",
        "created_at",
        "updated_at",
        "owner",
        "entries",
        "durable_outputs",
        "last_cleanup_receipt",
        "blocking_findings"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "revision": {"type": "integer", "minimum": 1},
        "run_id": {"type": "string", "minLength": 1},
        "command": {"$ref": "#/$defs/producer_command"},
        "producer_state": {
          "enum": ["preparing", "active", "finalizing", "succeeded", "failed"]
        },
        "cleanup_state": {
          "enum": ["not_eligible", "eligible", "in_progress", "completed", "cleanup_failed"]
        },
        "created_at": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/owner"},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "durable_outputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/durable_output"}
        },
        "last_cleanup_receipt": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["phase", "reclaimed_bytes", "preserved_bytes", "blocked_bytes"],
          "properties": {
            "phase": {"enum": ["preflight", "postflight"]},
            "reclaimed_bytes": {"type": "integer", "minimum": 0},
            "preserved_bytes": {"type": "integer", "minimum": 0},
            "blocked_bytes": {"type": "integer", "minimum": 0}
          }
        },
        "blocking_findings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "producer_command": {
      "enum": [
        "run",
        "pencil-sync",
        "verify-pencil-persistence",
        "verify-export-operation",
        "export-expected",
        "export-semantic-tree",
        "migrate-flow-contract",
        "draft-pen-from-tree",
        "enrich-pen",
        "map-pencil-context",
        "reverse-pen",
        "detect-drift",
        "checklist-from-drift",
        "compare-tree",
        "check-consistency",
        "audit-visual",
        "flow-to-screens",
        "draft-pen",
        "update-pen",
        "extract-tokens",
        "lint-tokens",
        "export-ir",
        "code-ir",
        "codegen",
        "ci",
        "review-report",
        "fix-report",
        "demo"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "process_start_token", "host_id", "boot_id", "verification"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "process_start_token": {"type": "string", "minLength": 1},
        "host_id": {"type": "string", "minLength": 1},
        "boot_id": {"type": "string", "minLength": 1},
        "verification": {"enum": ["LIVE", "DEAD", "UNKNOWN"]}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "kind",
        "device",
        "inode",
        "mode",
        "link_count",
        "logical_bytes",
        "retention",
        "references",
        "cleanup_status"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^\\.penflow-tmp/runs/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"
        },
        "kind": {"enum": ["regular_file", "directory"]},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0},
        "link_count": {"type": "integer", "minimum": 1},
        "logical_bytes": {"type": "integer", "minimum": 0},
        "retention": {"enum": ["working", "durable"]},
        "references": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "cleanup_status": {"enum": ["pending", "deleted", "preserved", "blocked", "error"]}
      }
    },
    "durable_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "finalized", "manifest_revision"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "finalized": {"type": "boolean"},
        "manifest_revision": {"type": "integer", "minimum": 1}
      }
    },
    "cleanup_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "logical_bytes", "code"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^\\.penflow-tmp/runs/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"
        },
        "logical_bytes": {"type": "integer", "minimum": 0},
        "code": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "cleanup_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"], "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
